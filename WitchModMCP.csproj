<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Meowalive.Mod.WitchModMCP</RootNamespace>
    <AssemblyName>WitchModMCP</AssemblyName>
    <GameFolderName>Witch's Apocalyptic Journey</GameFolderName>
    <GameDataNameBack>Witch's Apocalyptic Journey_Data</GameDataNameBack>
    <GameSteamid>3709430</GameSteamid>
    <GameManagedPath>F:\steam\steamapps\common\Witch's Apocalyptic Journey\Witch's Apocalyptic Journey_Data\Managed</GameManagedPath>
    <Configurations>Debug;Release;Debug 魔女 WitchModMCP;Release 魔女 WitchModMCP;</Configurations>
    <OutputPath>$(ProjectDir)WitchModMCP\Scripts\</OutputPath>
  </PropertyGroup>

  <Target Name="DebugPaths" BeforeTargets="Build">
    <Message Importance="high" Text="========== 路径调试信息 ==========" />
    <Message Importance="high" Text="  📁 GameManagedPath: $(GameManagedPath)" />
    <Message Importance="high" Text="==================================" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug 魔女 WitchModMCP|AnyCPU' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release 魔女 WitchModMCP|AnyCPU' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="WitchModMCP\Data\" />
    <Folder Include="WitchModMCP\Text\" />
    <Folder Include="WitchModMCP\ModResource\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WitchModMCP.Contracts\**\*.cs" />
    <Compile Remove="WitchModMCP\mcp_plugins\**\*.cs" />
    <Compile Remove="decompiled_game\**\*.cs" />
    <Compile Remove="DecompiledSource\**\*.cs" />
    <Compile Remove="game_src\**\*.cs" />
    <Compile Remove="decompiled_mods\**\*.cs" />
    <!-- DeveloperTools merged into WitchModMCP.Contracts -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="WebSocketSharp">
      <HintPath>$(ProjectDir)WitchModMCP\lib\websocket-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup Condition="Exists('$(GameManagedPath)')">
      <Reference Include="Witch">
        <HintPath>$(GameManagedPath)\Witch.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Witch.Core">
        <HintPath>$(GameManagedPath)\Witch.Core.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.InputLegacyModule">
        <HintPath>$(GameManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.IMGUIModule">
        <HintPath>$(GameManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Newtonsoft.Json">
        <HintPath>$(GameManagedPath)\Newtonsoft.Json.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="BuildMod" AfterTargets="Build"
          Condition="'$(BuildingContracts)' != 'true'">
    <MSBuild Projects="WitchModMCP.Contracts\WitchModMCP.Contracts.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);BuildingContracts=true" />
    <PropertyGroup>
      <ModDir>$(ProjectDir)WitchModMCP</ModDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(ModDir)\Scripts\Entry.dll" Condition="Exists('$(TargetDir)$(TargetName).dll')" />
    <Message Importance="high" Condition="Exists('$(ModDir)\Scripts\Entry.dll')" Text="✅ WitchModMCP.dll → WitchModMCP/Scripts/Entry.dll" />
    <Copy SourceFiles="$(ProjectDir)WitchModMCP.Contracts\bin\$(Configuration)\WitchModMCP.Contracts.dll" DestinationFiles="$(ModDir)\Scripts\WitchModMCP.Contracts.dll" Condition="Exists('$(ProjectDir)WitchModMCP.Contracts\bin\$(Configuration)\WitchModMCP.Contracts.dll')" />
    <Message Importance="high" Condition="Exists('$(ModDir)\Scripts\WitchModMCP.Contracts.dll')" Text="✅ WitchModMCP.Contracts.dll → Scripts/" />
    <MSBuild Projects="$(ModDir)\mcp_plugins\decompile\Decompile.csproj"
             Targets="Restore;Publish"
             Properties="PublishDir=$(ModDir)\mcp_plugins\decompile\publish\;Configuration=Release" />
  </Target>

  <Target Name="DeployMod" AfterTargets="BuildMod"
          Condition="$(Configuration.Contains('魔女')) And Exists('$(GameManagedPath)')">
    <PropertyGroup>
      <GameModsDir>$([System.IO.Path]::GetDirectoryName($(GameManagedPath)))\Mods\$(AssemblyName)</GameModsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(GameModsDir)" />
    <ItemGroup>
      <ModFiles Include="$(ProjectDir)WitchModMCP\**\*.*"
                Exclude="$(ProjectDir)WitchModMCP\mcp_plugins\**\bin\**;$(ProjectDir)WitchModMCP\mcp_plugins\**\obj\**" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(GameModsDir)\%(RecursiveDir)" />
    <Message Importance="high" Text="✅ 已部署 Mod 到: $(GameModsDir)" />
  </Target>

  <Target Name="CleanModFiles" AfterTargets="Clean">
    <ItemGroup>
      <DllsToDelete Include="$(ProjectDir)WitchModMCP\Scripts\*.dll"/>
      <DllsToDelete Include="$(ProjectDir)WitchModMCP\Scripts\*.pdb"/>
    </ItemGroup>
    <Delete Files="@(DllsToDelete)" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
