{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "witchmod": {
      "type": "local",
      "command": ["py", "run_gateway.py"],
      "cwd": ".",
      "environment": {
        "MCP_MOD_PORT": "3100",
        "MCP_HEARTBEAT_INTERVAL": "5",
        "MCP_HEARTBEAT_MAX_FAIL": "3"
      },
      "enabled": true
    }
  }
}
